# Archivo de ejemplo para variables de entorno.

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=Contraseña
DB_NAME=Nombrebasededatos
# DB_SSL=true solo en bases de datos administradas (Render, etc). En local se deja sin definir.
DB_SSL=false
JWT_SECRET=tu_clave_secreta_super_segura
JWT_EXPIRES_IN=8h

# Origenes permitidos por CORS, separados por coma (sin espacios). Si no se define,
# usa como valor por defecto localhost:4200 y localhost:3000.
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# Password del usuario admin que crea POST /seed la primera vez. Si no se define,
# usa 'admin123' por defecto (cambiala siempre despues del primer login).
ADMIN_DEFAULT_PASSWORD=admin123

# Envío automático de facturas por correo (Gmail)
# EMAIL_USER: tu correo de Gmail. EMAIL_APP_PASSWORD: contraseña de aplicación (no la contraseña normal),
# se genera en https://myaccount.google.com/apppasswords
EMAIL_USER=tucorreo@gmail.com
EMAIL_APP_PASSWORD=contraseña_de_aplicacion
APP_BASE_URL=http://localhost:3000


# Copia y pega ese ejemplo dentro de .env y rellena con datos reales
